-- ================================== ARM 0: ATTRIBUTION CARRY-FORWARD (4 rows)
-- Added by CEO AMENDMENT A1 (`operator_review/MAC-642/CEO_RATIFICATION.md` §2).
--
-- WHY THIS ARM EXISTS. The fold's justification is that the survivor is the
-- better row. On four of the 51 pairs that is FALSE on the manufacturer axis:
-- the superseded row is the SIG primary registry and carries the vendor, while
-- the survivor is a crowdsourced GitHub script (`nixxxo/tagfinder`) carrying
-- `manufacturer = NULL`. Folding those four WITHOUT this arm deletes the only
-- active row holding the attribution:
--
--   donor 37817 0xfe9f Google LLC        -> survivor 22878 (ble_service_uuid, NULL)
--   donor 38025 0xfdcd Qingping Techn... -> survivor 22865 (ble_service_uuid, NULL)
--   donor 38137 0xfd5a Samsung Electr... -> survivor 22864 (ble_service_uuid, NULL)
--   donor 38159 0xfd44 Apple Inc.        -> survivor 22876 (ble_service_uuid, NULL)
--
-- THREE OF THE FOUR ARE ALREADY SHIPPING UNATTRIBUTED. In the committed
-- `exports/argus_export.json` (981 entries, 18 of them unattributed), the
-- patterns `0000fd44-`, `0000fd5a-` and `0000fdcd-` all ship with
-- `"description": "Unattributed identifier"` — the CP8-ladder string
-- `_format_description` emits when vendor is unknown
-- (`db/validation/export_lynceus.py:747-749`). The fourth (`0000fe9f-`, Google)
-- does not ship at all: survivor 22878 is `device_category='unknown'` and bins
-- out at §11 #13. So this arm changes exactly THREE emitted descriptions.
--
-- ORDER IS LOAD-BEARING WITHIN THE TRANSACTION: the carry-forward is written
-- BEFORE ARM 2 supersedes the donors, so the value is never read out of a row
-- that has already left the active set.
--
-- THIS IS STILL NOT A PROMOTION. `manufacturer` participates in NO feed gate.
-- `argus_record_id` is `_sar10_hash(identifier_type, identifier)`
-- (`export_lynceus.py:1032`) and does not include manufacturer, so the emitted
-- ENTRY SET is unchanged and only `description` content moves. No
-- `device_category` changes, no `confidence` changes, no row crosses a floor —
-- survivor 22864 carries confidence 90 but is `crowdsourced`, which CP19
-- excludes from the high-confidence file, so it stays out of that file as
-- before. MAC-568's adjudication lane is untouched.
UPDATE identifiers SET manufacturer='Google LLC', notes=json_set(notes,'$.mac642_attribution_carry',json_object('issue','MAC-642','amendment','CEO A1','donor_id',37817,'donor_type','ble_company_id','donor_value','0xfe9f','carried','manufacturer','basis','SIG member_uuids.yaml primary_registry row superseded by this migration; attribution carried forward so the fold does not destroy it','not_a_promotion',1,'not_an_adjudication',1)) WHERE id=22878 AND manufacturer IS NULL AND superseded_by IS NULL AND (SELECT COUNT(*) FROM _mac642_go) = 1;
UPDATE identifiers SET manufacturer='Qingping Technology (Beijing) Co., Ltd.', notes=json_set(notes,'$.mac642_attribution_carry',json_object('issue','MAC-642','amendment','CEO A1','donor_id',38025,'donor_type','ble_company_id','donor_value','0xfdcd','carried','manufacturer','basis','SIG member_uuids.yaml primary_registry row superseded by this migration; attribution carried forward so the fold does not destroy it','not_a_promotion',1,'not_an_adjudication',1)) WHERE id=22865 AND manufacturer IS NULL AND superseded_by IS NULL AND (SELECT COUNT(*) FROM _mac642_go) = 1;
UPDATE identifiers SET manufacturer='Samsung Electronics Co., Ltd.', notes=json_set(notes,'$.mac642_attribution_carry',json_object('issue','MAC-642','amendment','CEO A1','donor_id',38137,'donor_type','ble_company_id','donor_value','0xfd5a','carried','manufacturer','basis','SIG member_uuids.yaml primary_registry row superseded by this migration; attribution carried forward so the fold does not destroy it','not_a_promotion',1,'not_an_adjudication',1)) WHERE id=22864 AND manufacturer IS NULL AND superseded_by IS NULL AND (SELECT COUNT(*) FROM _mac642_go) = 1;
UPDATE identifiers SET manufacturer='Apple Inc.', notes=json_set(notes,'$.mac642_attribution_carry',json_object('issue','MAC-642','amendment','CEO A1','donor_id',38159,'donor_type','ble_company_id','donor_value','0xfd44','carried','manufacturer','basis','SIG member_uuids.yaml primary_registry row superseded by this migration; attribution carried forward so the fold does not destroy it','not_a_promotion',1,'not_an_adjudication',1)) WHERE id=22876 AND manufacturer IS NULL AND superseded_by IS NULL AND (SELECT COUNT(*) FROM _mac642_go) = 1;

-- ================================================================== ARM 2: FOLD (51 rows)
-- CP32 §9 <other_id> SUCCESSOR semantics. NOT a self-loop: each target is a
-- surviving ACTIVE row carrying the same normalized value.
