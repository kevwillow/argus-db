UPDATE identifiers SET identifier_type='ble_uuid', identifier='0000feff-0000-1000-8000-00805f9b34fb', notes=json_set(notes,'$.mac642_retype',json_object('issue','MAC-642','from_type','ble_company_id','from_value','0xfeff','basis','SIG member_uuids.yaml; notes.source_row_key type field reads ble_uuid','not_a_promotion',1)) WHERE id=37724 AND identifier_type='ble_company_id' AND identifier='0xfeff' AND superseded_by IS NULL AND (SELECT COUNT(*) FROM _mac642_go) = 1;
