-- --------------------------------------------------------------- POST-CONDITIONS
-- Delta-based where the quantity is a delta; absolute only where the value is a
-- true invariant of THIS migration's scope. mig-0049's stale-absolute failure is
-- the reason this distinction is spelled out.

-- POST-1: exactly 51 rows left the active set.
-- MAC-642 POST-1 FAIL: active delta is not -51
CREATE TEMP TABLE _mac642_post_1fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_1fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers WHERE superseded_by IS NULL)
                 <> (SELECT active FROM _pre) - 51) THEN 0 ELSE 1 END;

-- POST-2: the 9 sub-0xFC00 company identifiers survive untouched.
-- MAC-642 POST-2 FAIL: the 9 genuine ble_company_id rows did not survive intact
CREATE TEMP TABLE _mac642_post_2fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_2fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers
                  WHERE superseded_by IS NULL AND identifier_type='ble_company_id') <> 9) THEN 0 ELSE 1 END;

-- POST-3: gate 1 is satisfied ON ITS OWN PREDICATE — no active ble_company_id
-- at or above the 0xFC00 member-UUID floor.
-- NOTE: `CAST(identifier AS INT)` is NOT usable here — it evaluates '0x004C' to
-- 0 and would make this check vacuously pass. All 9 survivors are '0x' + exactly
-- 4 hex digits, so a LOWER() string comparison IS an exact numeric comparison at
-- fixed width; the length/prefix arms below make that precondition explicit
-- instead of assuming it.
-- MAC-642 POST-3 FAIL: an active ble_company_id still sits at/above 0xFC00 (or is not 0x+4hex)
CREATE TEMP TABLE _mac642_post_3fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_3fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers
                  WHERE superseded_by IS NULL AND identifier_type='ble_company_id'
                    AND (LENGTH(identifier) <> 6
                      OR LOWER(identifier) NOT LIKE '0x%'
                      OR LOWER(identifier) >= '0xfc00')) <> 0) THEN 0 ELSE 1 END;

-- POST-4: ble_uuid grew by exactly the retype arm.
-- MAC-642 POST-4 FAIL: ble_uuid delta is not +654
CREATE TEMP TABLE _mac642_post_4fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_4fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers WHERE superseded_by IS NULL AND identifier_type='ble_uuid')
                 <> (SELECT bu FROM _pre) + 654) THEN 0 ELSE 1 END;

-- POST-5: THE LOAD-BEARING ONE. Zero duplicate emitted keys on the wire type
-- `ble_uuid`. This is the check a flat 705-row retype fails 51 times. It is NOT
-- a restatement of the transform: it counts (normalized value) groups carrying
-- more than one ACTIVE row across ALL THREE types that alias-collapse to the
-- `ble_uuid` wire type, which is a property of the whole table, not of this
-- migration's WHERE clauses.
-- MAC-642 POST-5 FAIL: duplicate emitted keys on wire type ble_uuid
CREATE TEMP TABLE _mac642_post_5fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_5fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM (
        SELECT LOWER(identifier) AS v FROM identifiers
        WHERE superseded_by IS NULL
          AND identifier_type IN ('ble_uuid','ble_service_uuid','ble_service')
        GROUP BY v HAVING COUNT(*) > 1)) <> 0) THEN 0 ELSE 1 END;

-- POST-6: THIS migration introduced no self-loop (every fold used <other_id>
-- SUCCESSOR semantics).
-- Scoped to `_scope`, NOT table-wide. A table-wide `superseded_by = id` count is
-- 246 at baseline — those are legitimate CP32 §9 WITHDRAWN rows under the
-- tri-semantic (NULL = active / <other_id> = successor / self-loop = withdrawn).
-- Asserting table-wide zero would fail on state this migration never touched and
-- would be asserting something 0051 has no business asserting.
-- MAC-642 POST-6 FAIL: a self-loop was introduced inside the mutation scope
CREATE TEMP TABLE _mac642_post_6fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_6fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers
                  WHERE id IN (SELECT id FROM _scope) AND superseded_by = id) <> 0) THEN 0 ELSE 1 END;

-- POST-7: every fold target is itself ACTIVE (no chain into a dead row).
-- MAC-642 POST-7 FAIL: a fold target is not active
CREATE TEMP TABLE _mac642_post_7fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_7fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers s
                  JOIN identifiers t ON t.id = s.superseded_by
                  WHERE json_valid(s.notes)
                    AND json_extract(s.notes,'$.mac642_fold.issue')='MAC-642'
                    AND t.superseded_by IS NOT NULL) <> 0) THEN 0 ELSE 1 END;

-- POST-8: notes stayed valid JSON across the whole mutation scope.
-- MAC-642 POST-8 FAIL: json_set produced invalid notes
CREATE TEMP TABLE _mac642_post_8fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_8fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers
                  WHERE json_valid(notes)=0
                    AND id IN (SELECT id FROM _scope)) <> 0) THEN 0 ELSE 1 END;

-- POST-9: both arms touched exactly the intended row counts.
-- MAC-642 POST-9 FAIL: retype arm did not touch 654 rows
CREATE TEMP TABLE _mac642_post_9fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_9fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers WHERE json_valid(notes) AND json_extract(notes,'$.mac642_retype.issue')='MAC-642') <> 654) THEN 0 ELSE 1 END;
-- MAC-642 POST-10 FAIL: fold arm did not touch 51 rows
CREATE TEMP TABLE _mac642_post_10fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_10fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers WHERE json_valid(notes) AND json_extract(notes,'$.mac642_fold.issue')='MAC-642') <> 51) THEN 0 ELSE 1 END;

-- POST-11 .. POST-13 — CEO AMENDMENT A1 (ARM 0).

-- POST-11: all four survivors now carry the DONOR's exact vendor string, and
-- all four are still ACTIVE. Value-level, not a bare row count: a count alone
-- would pass if ARM 0 wrote the wrong vendor into the right row.
-- MAC-642 POST-11 FAIL: the 4 attribution carry-forwards did not land byte-exact
CREATE TEMP TABLE _mac642_post_11fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_11fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers
                  WHERE superseded_by IS NULL
                    AND ((id=22878 AND manufacturer='Google LLC')
                      OR (id=22865 AND manufacturer='Qingping Technology (Beijing) Co., Ltd.')
                      OR (id=22864 AND manufacturer='Samsung Electronics Co., Ltd.')
                      OR (id=22876 AND manufacturer='Apple Inc.'))) <> 4) THEN 0 ELSE 1 END;

-- POST-12: NO OTHER row's manufacturer moved. Whole-table NULL count must fall
-- by EXACTLY 4. Neither the retype nor the fold writes `manufacturer`, so any
-- other delta means this migration mutated attribution outside its own scope.
-- This is the assertion that makes ARM 0 bounded rather than merely intended.
-- MAC-642 POST-12 FAIL: whole-table manufacturer-NULL delta is not exactly -4
CREATE TEMP TABLE _mac642_post_12fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_12fail(ok) SELECT CASE WHEN ((SELECT COUNT(*) FROM identifiers WHERE manufacturer IS NULL)
                 <> (SELECT mfr_null FROM _pre) - 4) THEN 0 ELSE 1 END;

-- POST-13: exactly 4 rows carry the carry-forward marker, and every one of them
-- is the SUCCESSOR of a row this migration superseded. Proves ARM 0 and ARM 2
-- agree on which pairs they are talking about — a marker on a row nothing folds
-- into would mean the two arms drifted apart.
-- MAC-642 POST-13 FAIL: carry-forward markers do not pair 1:1 with folded donors
CREATE TEMP TABLE _mac642_post_13fail (ok INTEGER CHECK (ok = 1));
INSERT INTO _mac642_post_13fail(ok) SELECT CASE WHEN (
                 (SELECT COUNT(*) FROM identifiers WHERE json_valid(notes)
                    AND json_extract(notes,'$.mac642_attribution_carry.issue')='MAC-642') <> 4
              OR (SELECT COUNT(*) FROM identifiers s
                  JOIN identifiers d ON d.id = json_extract(s.notes,'$.mac642_attribution_carry.donor_id')
                  WHERE json_valid(s.notes)
                    AND json_extract(s.notes,'$.mac642_attribution_carry.issue')='MAC-642'
                    AND d.superseded_by = s.id
                    AND d.manufacturer = s.manufacturer) <> 4) THEN 0 ELSE 1 END;

DROP TABLE _pre;
DROP TABLE _scope;
DROP TABLE _mac642_go;
DROP TABLE _mac642_pre_1fail;
DROP TABLE _mac642_pre_2fail;
DROP TABLE _mac642_pre_3fail;
DROP TABLE _mac642_pre_4fail;
DROP TABLE _mac642_pre_5fail;
DROP TABLE _mac642_pre_6fail;
DROP TABLE _mac642_pre_7fail;
DROP TABLE _mac642_pre_8fail;
DROP TABLE _mac642_post_1fail;
DROP TABLE _mac642_post_2fail;
DROP TABLE _mac642_post_3fail;
DROP TABLE _mac642_post_4fail;
DROP TABLE _mac642_post_5fail;
DROP TABLE _mac642_post_6fail;
DROP TABLE _mac642_post_7fail;
DROP TABLE _mac642_post_8fail;
DROP TABLE _mac642_post_9fail;
DROP TABLE _mac642_post_10fail;
DROP TABLE _mac642_post_11fail;
DROP TABLE _mac642_post_12fail;
DROP TABLE _mac642_post_13fail;
COMMIT;
-- ============================================================================
-- Expected post-state, stated as a DELTA against the pre-apply state because
-- this migration lands on top of mig-0049 and any absolute count written here
-- rots (43160 pre-0049 -> 43140 post-0049 -> 43089 post-0051):
--   active         : (pre) - 51
--   ble_company_id : 9      (absolute — a true invariant of this scope)
--   ble_uuid       : (pre) + 654
--   duplicate emitted keys on wire type ble_uuid : 0
-- ============================================================================
