# --- Argus repo hygiene -----------------------------------------------
# Per Bible §6 Phase 0: keep raw/ and large db/ artifacts out of git.

# Raw scraped sources — frequently large, regenerable from `sources` table.
raw/

# Operational logs + per-runtime state (pacer ledgers, fetch logs, etc.).
# Per-runtime state lives here; not provenance, not tracked.
logs/

# Built sqlite databases — regenerable from raw + extraction pipeline.
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# Root-level sqlite strays. A DB-named file at the repo root is one `git add -A`
# from becoming a real incident, and the push stack already carries three
# oversized DB blobs (MAC-641 apply; CEO ratification 1f5d4ded). Root only —
# does not shadow db/ or exports/, which have their own rules above and below.
/*.db
/*.db-journal
/*.db-wal
/*.db-shm

# Exports are intentionally tracked when small; large ones via Phase 5 only.
exports/*.db

# Python tooling / venv noise (argus_cli.py and any extraction workers).
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*
*.env

# Editor / OS detritus.
.DS_Store
.idea/
.vscode/
*.swp

# WiGLE per-runtime artifacts (extracted to top-level wigle/ per MAC-1 4df426c7).
# Pattern parity with raw/ + logs/ exclusions above; canonical DB rows live in db/argus.db.
wigle/raw/
wigle/pacer.json

# Flock-back source admission session deliverables — staged for Paperclip
# Validator review; CEO commits selectively after promotion. Per runbook §4.
extraction_outputs/flock_back_admission/

# fccid.io + FCC EAS Filings admission session deliverables (MAC-101). Same
# posture as flock_back_admission above — staged for validator; CEO commits
# selectively post-promotion. Includes raw OCR text dumps + per-FCC-ID
# extraction JSON. Added Patch Cycle 1 Step 3 (2026-05-17).
extraction_outputs/fccid_io_admission/

# Autonomous overnight wave (2026-05-17) — 6 parallel sub-agents on remaining
# runguides. Same staging-only posture; raw artifacts under raw/; structured
# extractions under extraction_outputs/{slug}/. Validator promotes selectively.
extraction_outputs/_autonomous_overnight/
extraction_outputs/ised_rel_admission/
extraction_outputs/bt_sig_qualified_designs_admission/
extraction_outputs/ofcom_acma_admission/
extraction_outputs/wave_g_v2_admission/
extraction_outputs/patent_text_mining_admission/
extraction_outputs/github_mass_search_admission/

# Wave G sandbox — vendor-derived artifacts per bible §11 #15 decompile-source carveout.
# NOT gitignored: android_test/WAVE_G_RUNBOOK.md (workflow document) +
# android_test/tools/extraction/wave_g_extractor.py (workflow code).
# Added Correction Pass 17 (2026-05-13).
android_test/raw/
android_test/extraction_outputs/

# Android decompile tooling — large, per-host binaries; reinstall locally.
# env.sh has hardcoded $HOME paths so it is not portable; keep local-only.
android_test/tools/apkeep
android_test/tools/apktool/
android_test/tools/jadx/
android_test/tools/jdk/
android_test/tools/env.sh

# Point-in-time DB / export / extraction snapshots — local rollback aid only.
# DB backups covered by the broader `db/*_backup*` pattern below.
# Pattern matches files like `argus_export.csv.pre_mac110_backup`,
# `coverage_matrix_report.json.pre_mac100_backup`, etc.
exports/*.pre_*_backup
extraction_outputs/**/*.pre_*_backup
# Current naming is `<file>.pre_<topic>_<UTC-timestamp>` with NO `_backup` suffix, so the
# two rules above do not match it — the same gap `db/argus.db.pre_*` closes for the DB
# (MAC-362). It matters here because MAC-703 re-tracks `extraction_outputs/mac45/`: without
# this rule a `git add extraction_outputs/mac45/` sweeps in four ~10MB point-in-time
# snapshots alongside the two artifacts that are meant to be tracked.
exports/*.pre_*
extraction_outputs/**/*.pre_*

# Agent control state (per-instance, do not commit)
.claude-flow/

# DB phase backup snapshots (extends existing db/*.db rule for *_backup-suffixed files).
# Covers legacy `argus.db.pre_<token>_backup`, `argus.db.<dispatch>_step<N>_pre_backup`,
# and current `argus.db.pre_<topic>_<UTC-timestamp>` naming conventions (MAC-239 / Wave G/H v1).
db/*_backup*
db/*_backup*.sha256
db/argus.db.pre_*
# Per-dispatch pre-apply DB snapshots (311 MB each) — `argus.db.mac<NNN>_pre_apply_<UTC>[_<sha>].bak`
# and any `argus.db*.bak` variant. The `db/argus.db.pre_*` rule above does NOT match the
# `argus.db.mac…_pre_apply` naming, so these slipped past .gitignore (MAC-362 ship-gate landmine).
db/argus.db*.bak
db/argus.db.mac*_pre_apply_*

# Cycle-specific raw-snapshot exports (Wave G/H v1 onward). Canonical Lynceus exports remain
# committed; per-cycle raw snapshots live on disk for next-cycle consumer reference but do not
# enter canonical repo history (300MB+ DB dumps + 28MB JSON exports per cycle would bloat history).
exports/v*_raw_snapshot/
exports/*_raw_snapshot/

# Canonical extractor version backups — kept on disk for rollback, not committed (git history
# already tracks prior versions via commit log). MAC-239 v4 → v5 case at
# `android_test/tools/extraction/wave_g_extractor.py.v4_backup_<UTC-timestamp>`.
android_test/tools/extraction/*.v[0-9]_backup_*
android_test/tools/extraction/*.v[0-9][0-9]_backup_*

# Internal planning / point-in-time artifacts — keep the canonical tree clean of
# staged migrations, pre-action backups, stop-the-line memos, handoff docs, patch-cycle
# summaries, pre-tag audit dirs, and probe logs. These are operational scratch, archived
# to the internal sandbox when needed. Narrow patterns validated against canonical files
# (__init__.py, docs/internal/, exports/_export_manifest.json, bible/history/, root stubs).
# Added MAC-278 (post-v1.6.1 repo-hygiene cleanup).
*_STAGED.py
*.pre_*_backup
*.pre_wave_*
*.pre_cp*
STOP_THE_LINE_*.md
HANDOFF_*.md
_patch_cycle_*/
_v1_*_pretag*/
_probe_log.md

# MAC-717: raw captured HTTP/scan response bodies must never be tracked. They carry
# whatever the scanned host was serving, which has included live third-party
# credentials and PII (shodan_raw/F1_upnp_module.json embedded a Google OAuth secret,
# purged from history). The promoted output of a harvest is tracked; the raw layer is
# not. Content of the removed files is preserved by sha256 in the sibling *_MANIFEST.md.
extraction_outputs/**/shodan_raw/
extraction_outputs/**/*_raw/
